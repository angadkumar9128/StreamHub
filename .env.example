# copy to .env
ADMIN_API_KEY=sh_live_change_me
KAFKA_BROKERS=redpanda:9092
DATABASE_URL=postgresql://streamhub:streamhub@postgres:5432/streamhub
# Endpoint returned to external/Kafka consumers. Local development uses localhost.
PUBLIC_KAFKA_BOOTSTRAP=localhost:19092
RATE_LIMIT_PER_SEC=200
# Host/IP/DNS advertised to external Kafka clients such as Databricks.
# Keep localhost for local-only use; set a reachable DNS name/IP for Databricks Cloud.
KAFKA_EXTERNAL_HOST=localhost
